{
  "name": "Delivery Day",
  "short_name": "Delivery Day",
  "description": "Peça em bares, restaurantes e mercados pelo Delivery Day.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#f55a1d",
  "lang": "pt-BR",
  "icons": [
    {
      "src": "/api/platform-branding/assets/appIcon",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/api/platform-branding/assets/appIcon",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
